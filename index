<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplicações Financeiras</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            background-color: #E8E8E8;
            color: #000000;
        }

        /* Header Principal */
        .header-main {
            background-color: #4472C4;
            color: white;
            padding: 4px 8px;
            font-weight: bold;
            font-size: 12px;
            border-bottom: 1px solid #999999;
        }

        /* Container Principal */
        .container {
            background-color: white;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Grid de Listagem */
        .grid-section {
            flex: 1;
            overflow: auto;
            background-color: white;
        }

        .grid-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #999999;
        }

        .grid-table thead {
            background-color: #4472C4;
            color: white;
            font-weight: bold;
            font-size: 11px;
            position: sticky;
            top: 0;
        }

        .grid-table th {
            padding: 4px 8px;
            text-align: left;
            border-right: 1px solid #999999;
            border-bottom: 1px solid #999999;
        }

        .grid-table th:last-child {
            border-right: none;
        }

        .grid-table tbody tr {
            border-bottom: 1px solid #999999;
        }

        .grid-table tbody tr:nth-child(even) {
            background-color: #F5F5F5;
        }

        .grid-table tbody tr:hover {
            background-color: #E0E0FF;
            cursor: pointer;
        }

        .grid-table td {
            padding: 4px 8px;
            border-right: 1px solid #999999;
            font-size: 11px;
        }

        .grid-table td:last-child {
            border-right: none;
        }

        /* Seção de Detalhes */
        .details-section {
            background-color: #E8E8E8;
            border-top: 1px solid #999999;
            flex: 1;
            overflow-y: auto;
        }

        /* Header da Seção de Detalhes */
        .details-header {
            background-color: #4472C4;
            color: white;
            padding: 4px 8px;
            font-weight: bold;
            font-size: 12px;
            border-bottom: 1px solid #999999;
            display: flex;
            gap: 4px;
            align-items: center;
        }

        .details-header button {
            padding: 2px 6px;
            background-color: #4472C4;
            color: white;
            border: 1px solid white;
            cursor: pointer;
            font-size: 11px;
            min-width: 60px;
            height: 22px;
        }

        .details-header button:hover {
            background-color: #335AA0;
        }

        /* Abas */
        .tabs {
            display: flex;
            background-color: #E8E8E8;
            border-bottom: 1px solid #999999;
            padding: 0;
        }

        .tab {
            padding: 6px 12px;
            background-color: #E8E8E8;
            border: 1px solid #999999;
            border-bottom: none;
            cursor: pointer;
            font-size: 11px;
            margin-right: 2px;
            color: #000000;
            border-radius: 2px 2px 0 0;
        }

        .tab:hover {
            background-color: #D0D0D0;
        }

        .tab.active {
            background-color: white;
            border-bottom: 1px solid white;
            font-weight: bold;
        }

        /* Conteúdo de Aba */
        .tab-content {
            display: none;
            padding: 10px;
            background-color: white;
            border-top: 1px solid #999999;
        }

        .tab-content.active {
            display: block;
        }

        /* Fieldset e Grupos de Campos */
        .fieldset {
            border: 1px solid #999999;
            margin: 8px 0;
            padding: 10px;
            background-color: white;
        }

        .fieldset legend {
            padding: 0 4px;
            font-weight: bold;
            font-size: 11px;
            background-color: white;
        }

        /* Linha de Campos */
        .field-row {
            display: flex;
            gap: 20px;
            margin-bottom: 8px;
            align-items: flex-start;
        }

        .field-group {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .field-group label {
            font-size: 11px;
            font-weight: normal;
            margin-bottom: 2px;
            color: #000000;
        }

        .field-group input[type="text"],
        .field-group input[type="number"],
        .field-group select {
            padding: 3px 4px;
            border: 1px solid #999999;
            font-size: 11px;
            font-family: Arial, sans-serif;
            background-color: white;
            color: #000000;
        }

        .field-group input[type="text"]:focus,
        .field-group input[type="number"]:focus,
        .field-group select:focus {
            outline: none;
            border-color: #4472C4;
            background-color: #FFFFCC;
        }

        .field-group input:disabled,
        .field-group select:disabled {
            background-color: #F0F0F0;
            color: #666666;
            cursor: not-allowed;
        }

        .error-message {
            color: #D32F2F;
            font-size: 11px;
            margin-top: 3px;
            display: none;
        }

        .error-message.show {
            display: block;
        }

        .field-group.error input,
        .field-group.error select {
            border-color: #D32F2F !important;
            background-color: #FFEBEE !important;
        }

        /* Selectbox width */
        select {
            min-width: 100px;
        }

        input[type="text"] {
            min-width: 120px;
        }

        input[type="number"] {
            min-width: 80px;
        }

        /* Responsivo */
        @media (max-width: 768px) {
            .container {
                flex-direction: column;
            }

            .grid-section {
                flex: 1;
                min-height: 200px;
            }

            .details-section {
                flex: 1;
                max-height: none;
            }

            .field-row {
                flex-direction: column;
                gap: 10px;
            }

            .field-group {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header Principal -->
        <div class="header-main">
            Aplicações Financeiras
        </div>

        <!-- VISUAL FUNCTION 1: Listagem de Aplicações -->
        <div style="background-color: #E8E8E8; padding: 4px 8px; border-bottom: 1px solid #999999; display: flex; gap: 4px; align-items: center;">
            <button onclick="calcularDeRE()" style="padding: 2px 12px; background-color: #4472C4; color: white; border: 1px solid #999999; cursor: pointer; font-size: 11px; min-width: 100px; height: 24px;">Calcular DeRE</button>
        </div>
        <div class="grid-section">
            <table class="grid-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Descrição do Ativo</th>
                        <th>Valor Saldo Inicial</th>
                        <th>Conta Contábil</th>
                    </tr>
                </thead>
                <tbody id="gridBody">
                    <tr class="grid-row">
                        <td class="grid-codigo"></td>
                        <td class="grid-descricao"></td>
                        <td class="grid-valor"></td>
                        <td class="grid-conta"></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- VISUAL FUNCTION 2: Manutenção de Aplicação -->
        <div class="details-section">
            <!-- Header da Seção de Detalhes -->
            <div class="details-header">
                Aplicações Financeiras
                <button title="Incluir" onclick="iniciarNovoRegistro()">Incluir</button>
                <button title="Salvar" onclick="salvarAplicacao()">Salvar</button>
                <button title="Cancelar" onclick="cancelarEdicao()">Cancelar</button>
                <button title="Excluir" onclick="excluirAplicacao()">Excluir</button>
            </div>

            <!-- Abas -->
            <div class="tabs">
                <div class="tab active" onclick="switchTab(this, 'identificacao')">Identificação</div>
            </div>

            <!-- Conteúdo da Aba Identificação -->
            <div id="identificacao" class="tab-content active">
                <div class="fieldset">
                    <legend>Identificação</legend>

                    <div class="field-row">
                        <div class="field-group" style="flex: 0 0 150px;">
                            <label for="codigo">Código</label>
                            <input type="text" id="codigo" value="" list="codigos-list" placeholder="Ex: 0000000001" disabled>
                            <datalist id="codigos-list"></datalist>
                            <div class="error-message" id="erro-codigo">Campo obrigatório</div>
                        </div>
                        <div class="field-group">
                            <label for="descricao">Descrição do Ativo</label>
                            <input type="text" id="descricao" value="" disabled>
                            <div class="error-message" id="erro-descricao">Campo obrigatório</div>
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field-group">
                            <label for="valor-saldo">Valor Saldo Inicial</label>
                            <input type="text" id="valor-saldo" value="" placeholder="Entrada em moeda" disabled>
                            <div class="error-message" id="erro-valor">Campo obrigatório</div>
                        </div>
                        <div class="field-group">
                            <label for="conta-contabil">Conta Contábil</label>
                            <select id="conta-contabil" disabled>
                                <option value="">Selecione uma conta...</option>
                                <option>1.1.1.01.001 - Aplicações Financeiras Renda Fixa</option>
                                <option>1.1.1.01.002 - Aplicações Financeiras Renda Variável</option>
                                <option>1.1.1.02.001 - CDB e Títulos de Renda Fixa</option>
                                <option>1.1.1.02.002 - Fundos de Investimento Conservador</option>
                                <option>1.1.1.03.001 - Poupança e Depósitos de Curto Prazo</option>
                                <option>1.1.1.04.001 - Ações e Títulos Patrimoniais</option>
                                <option>1.1.1.04.002 - Fundos Multimercado</option>
                                <option>1.1.1.05.001 - Derivativos e Operações Estruturadas</option>
                                <option>1.1.1.06.001 - Operações com Moeda Estrangeira</option>
                                <option>1.1.1.07.001 - Aplicações Financeiras em Fase de Liquidação</option>
                            </select>
                            <div class="error-message" id="erro-conta">Campo obrigatório</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Variável para rastrear o estado de edição
        let emEdicao = false;
        let dadosAntesDaEdicao = {};

        // Carrega dados salvos ao abrir a página
        function loadFormData() {
            const savedData = localStorage.getItem('aplicacoes_financeiras_data');
            if (savedData) {
                const data = JSON.parse(savedData);
                Object.keys(data).forEach(fieldId => {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        if (field.type === 'checkbox') {
                            field.checked = data[fieldId];
                        } else {
                            field.value = data[fieldId];
                        }
                    }
                });
            }
        }

        // Atualiza o grid com as alterações do formulário
        function updateGridFromForm() {
            const codigo = document.getElementById('codigo').value;
            const descricao = document.getElementById('descricao').value;
            const valor = document.getElementById('valor-saldo').value;
            const conta = document.getElementById('conta-contabil').value;

            // Atualiza as células da primeira linha do grid
            const gridRow = document.querySelector('#gridBody tr');
            if (gridRow) {
                gridRow.querySelector('.grid-codigo').textContent = codigo;
                gridRow.querySelector('.grid-descricao').textContent = descricao;
                gridRow.querySelector('.grid-valor').textContent = valor;
                gridRow.querySelector('.grid-conta').textContent = conta;
            }
        }

        // Salva dados quando há alteração
        function saveFormDataWithGridUpdate() {
            const formData = {};
            const inputs = document.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                if (input.id) {
                    if (input.type === 'checkbox') {
                        formData[input.id] = input.checked;
                    } else {
                        formData[input.id] = input.value;
                    }
                }
            });
            localStorage.setItem('aplicacoes_financeiras_data', JSON.stringify(formData));
            console.log('Dados salvos:', new Date().toLocaleTimeString());
            updateGridFromForm();
        }

        // Adiciona listeners para todos os campos
        function attachListeners() {
            const inputs = document.querySelectorAll('input, select, textarea');
            inputs.forEach(input => {
                input.addEventListener('change', saveFormDataWithGridUpdate);
                input.addEventListener('input', saveFormDataWithGridUpdate);
                input.addEventListener('blur', saveFormDataWithGridUpdate);
            });
        }

        function switchTab(tabElement, contentId) {
            // Remove active de todas as abas
            const tabs = document.querySelectorAll('.tab');
            tabs.forEach(tab => tab.classList.remove('active'));

            // Remove active de todos os conteúdos
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => content.classList.remove('active'));

            // Adiciona active na aba clicada
            tabElement.classList.add('active');

            // Adiciona active no conteúdo correspondente
            document.getElementById(contentId).classList.add('active');
        }

        // Gera sugestões de códigos
        function gerarCodigosSugeridos() {
            const datalist = document.getElementById('codigos-list');
            datalist.innerHTML = '';

            for (let i = 1; i <= 100; i++) {
                const codigo = String(i).padStart(10, '0');
                const option = document.createElement('option');
                option.value = codigo;
                datalist.appendChild(option);
            }
        }

        // Habilita edição
        function habilitarEdicao() {
            document.querySelectorAll('input, select').forEach(field => {
                field.removeAttribute('disabled');
            });
        }

        // Desabilita edição
        function desabilitarEdicao() {
            document.querySelectorAll('input, select').forEach(field => {
                field.setAttribute('disabled', 'disabled');
            });
        }

        // Inicia novo registro
        function iniciarNovoRegistro() {
            emEdicao = true;

            // Salva dados atuais antes de limpar
            dadosAntesDaEdicao = {
                codigo: document.getElementById('codigo').value,
                descricao: document.getElementById('descricao').value,
                'valor-saldo': document.getElementById('valor-saldo').value,
                'conta-contabil': document.getElementById('conta-contabil').value
            };

            // Limpa o formulário
            document.getElementById('codigo').value = '';
            document.getElementById('descricao').value = '';
            document.getElementById('valor-saldo').value = '';
            document.getElementById('conta-contabil').value = '';

            // Limpa mensagens de erro
            document.querySelectorAll('.error-message').forEach(msg => msg.classList.remove('show'));
            document.querySelectorAll('.field-group').forEach(fg => fg.classList.remove('error'));

            // Habilita campos
            habilitarEdicao();

            // Foca no primeiro campo
            document.getElementById('codigo').focus();
        }

        // Valida formulário
        function validarFormulario() {
            let valido = true;

            // Limpa mensagens de erro anteriores
            document.querySelectorAll('.error-message').forEach(msg => msg.classList.remove('show'));
            document.querySelectorAll('.field-group').forEach(fg => fg.classList.remove('error'));

            // Valida código
            const codigo = document.getElementById('codigo').value.trim();
            if (!codigo) {
                document.getElementById('erro-codigo').classList.add('show');
                document.getElementById('codigo').parentElement.classList.add('error');
                valido = false;
            }

            // Valida descrição
            const descricao = document.getElementById('descricao').value.trim();
            if (!descricao) {
                document.getElementById('erro-descricao').classList.add('show');
                document.getElementById('descricao').parentElement.classList.add('error');
                valido = false;
            }

            // Valida valor
            const valor = document.getElementById('valor-saldo').value.trim();
            if (!valor) {
                document.getElementById('erro-valor').classList.add('show');
                document.getElementById('valor-saldo').parentElement.classList.add('error');
                valido = false;
            }

            // Valida conta
            const conta = document.getElementById('conta-contabil').value;
            if (!conta) {
                document.getElementById('erro-conta').classList.add('show');
                document.getElementById('conta-contabil').parentElement.classList.add('error');
                valido = false;
            }

            return valido;
        }

        // Salva aplicação
        function salvarAplicacao() {
            if (!validarFormulario()) {
                return;
            }

            const codigo = document.getElementById('codigo').value;
            const descricao = document.getElementById('descricao').value;
            const valor = document.getElementById('valor-saldo').value;
            const conta = document.getElementById('conta-contabil').value;

            // Salva dados no localStorage
            const formData = {
                codigo: codigo,
                descricao: descricao,
                'valor-saldo': valor,
                'conta-contabil': conta
            };
            localStorage.setItem('aplicacoes_financeiras_data', JSON.stringify(formData));

            // Atualiza grid
            updateGridFromForm();

            // MANTÉM os dados em tela - NÃO desabilita os campos
            emEdicao = false;

            // Limpa mensagens de erro
            document.querySelectorAll('.error-message').forEach(msg => msg.classList.remove('show'));
            document.querySelectorAll('.field-group').forEach(fg => fg.classList.remove('error'));

            alert('Aplicação salva com sucesso!');
        }

        // Cancela edição
        function cancelarEdicao() {
            if (emEdicao) {
                if (confirm('Deseja cancelar? As alterações não salvas serão perdidas.')) {
                    // Restaura dados anteriores se houver
                    if (Object.keys(dadosAntesDaEdicao).length > 0) {
                        Object.keys(dadosAntesDaEdicao).forEach(fieldId => {
                            const field = document.getElementById(fieldId);
                            if (field) {
                                field.value = dadosAntesDaEdicao[fieldId];
                            }
                        });
                    } else {
                        // Ou limpa se for novo registro
                        document.getElementById('codigo').value = '';
                        document.getElementById('descricao').value = '';
                        document.getElementById('valor-saldo').value = '';
                        document.getElementById('conta-contabil').value = '';
                    }

                    // Desabilita campos
                    desabilitarEdicao();
                    emEdicao = false;

                    // Limpa mensagens de erro
                    document.querySelectorAll('.error-message').forEach(msg => msg.classList.remove('show'));
                    document.querySelectorAll('.field-group').forEach(fg => fg.classList.remove('error'));
                }
            }
        }

        // Exclui aplicação
        function excluirAplicacao() {
            if (confirm('Deseja excluir esta aplicação?')) {
                // Limpa o formulário
                document.getElementById('codigo').value = '';
                document.getElementById('descricao').value = '';
                document.getElementById('valor-saldo').value = '';
                document.getElementById('conta-contabil').value = '';

                // Limpa mensagens de erro
                document.querySelectorAll('.error-message').forEach(msg => msg.classList.remove('show'));
                document.querySelectorAll('.field-group').forEach(fg => fg.classList.remove('error'));

                // Limpa dados
                localStorage.setItem('aplicacoes_financeiras_data', JSON.stringify({}));
                updateGridFromForm();

                // Desabilita campos
                desabilitarEdicao();
                emEdicao = false;

                alert('Aplicação excluída com sucesso!');
            }
        }

        // Função para calcular DeRE
        function calcularDeRE() {
            const codigo = document.getElementById('codigo').value;
            const descricao = document.getElementById('descricao').value;
            const valor = document.getElementById('valor-saldo').value;
            const conta = document.getElementById('conta-contabil').value;

            if (!codigo || !descricao || !valor || !conta) {
                alert('Preencha todos os campos antes de calcular a DeRE');
                return;
            }

            // Aqui você pode implementar a lógica de cálculo da DeRE
            alert('Cálculo de DeRE iniciado para:\n\nCódigo: ' + codigo + '\nDescrição: ' + descricao + '\nValor: ' + valor + '\nConta: ' + conta);
        }

        // Carrega dados ao abrir a página
        window.addEventListener('DOMContentLoaded', () => {
            gerarCodigosSugeridos();
            loadFormData();
            attachListeners();
            updateGridFromForm();
        });
    </script>
</body>
</html>
